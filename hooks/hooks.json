{
  "description": "Advisory Japanese writing lint after Write and Edit. A no-op unless the project has .claude/ja-lint/.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ja_lint/post_hook.py\""
          }
        ]
      }
    ]
  }
}
